<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope {{.EnvelopeAttributes}}>
<soap:Header>
<wsa:To>{{ "{{" }}.To{{ "}}" }}</wsa:To>
<wsa:Action>{{.ActionType}}</wsa:Action>
<wsa:MessageID>urn:uuid:{{ "{{" }}.MessageID{{ "}}" }}</wsa:MessageID>
{{ "{{" }}if .RelatesTo{{ "}}" }}<wsa:RelatesTo>{{ "{{" }}.RelatesTo{{ "}}" }}</wsa:RelatesTo>{{ "{{" }}end{{ "}}" }}
{{ "{{" }}if .ReplyToAddress{{ "}}" }}<wsa:ReplyTo><wsa:Address>{{ "{{" }}.ReplyToAddress{{ "}}" }}</wsa:Address></wsa:ReplyTo>{{ "{{" }}end{{ "}}" }}
